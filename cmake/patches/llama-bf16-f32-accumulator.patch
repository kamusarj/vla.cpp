+        const float * x,const float * cos_t,const float * sin_t,float * dst,
+        int64_t nelements,int32_t head_dim,int64_t tokens,int64_t heads) {
+    const int64_t index=(int64_t)blockIdx.x*blockDim.x+threadIdx.x;
+    if(index>=nelements) return;
+    const int32_t d=(int32_t)(index%head_dim);
+    const int64_t token=(index/head_dim)%tokens;
+    const int64_t head=index/(head_dim*tokens);
+    if(head>=heads) return;
+    const int64_t src_base=token*(heads*head_dim)+head*head_dim;
+    const int32_t half=head_dim/2;
+    const float rotated=d<half ? -x[src_base+d+half] : x[src_base+d-half];
+    const int64_t position=token*head_dim+d;
+    const float direct=bf16_round_f32(x[src_base+d]*cos_t[position]);
+    const float turn=bf16_round_f32(rotated*sin_t[position]);
+    dst[index]=bf16_round_f32(direct+turn);
+}
